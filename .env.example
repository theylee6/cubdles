# -----------------------------------------------------------------------------
# Cubdles environment variables. Copy to .env.local for local development.
# NEVER commit real values. In production, set these in Vercel → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Public URL of the site (used for metadata, sitemap and auth redirect links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys. Use the publishable key (sb_publishable_…); it is safe in the browser because RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key. SERVER ONLY — bypasses row-level security.
# Used by webhooks, cron jobs and audited admin operations. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Protects scheduled jobs (/api/cron/*). 32+ random characters, e.g. `openssl rand -hex 32`. Vercel sends it automatically to cron routes.
CRON_SECRET=

# Optional: public support address shown on the site and in safety emails.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Social sign-in buttons to show, only after enabling the provider in Supabase: google,apple (empty = email only).
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Email notifications (match, message, fraud-ban emails) ------------------
# Resend → API Keys (sending access). Without it, emails stay queued and nothing is lost.
RESEND_API_KEY=
# Sender; the domain must be verified in Resend.
EMAIL_FROM=Cubdles <no-reply@cubdles.com>
# Shared with the database scheduler (Supabase Vault "notify_dispatch_secret"); see supabase/setup/notifications.sql.
NOTIFY_DISPATCH_SECRET=

# --- Payments (Razorpay subscriptions) ----------------------------------------
# Razorpay → Account & Settings → API Keys. Without them, Plus is shown as "not on sale yet".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks: URL https://<site>/api/webhooks/razorpay, events subscription.*; the secret you set there.
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Not used yet: SMS provider (phone sign-in), web push keys, Sentry DSN, an image-moderation provider,
# a UK age-assurance provider.
# -----------------------------------------------------------------------------

# Local database tests only (scripts/test-db.sh): a Postgres superuser with PostGIS.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
