{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/cron/purge-accounts",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/notifications/dispatch",
      "schedule": "15 3 * * *"
    }
  ]
}
